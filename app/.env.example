# Copier en .env et adapter pour la production
PORT=3000
NODE_ENV=production
# Secret JWT (générer : openssl rand -hex 48). Sinon un secret local est créé automatiquement.
JWT_SECRET=
# Compte initial créé au premier démarrage (si la base est vide)
ADMIN_EMAIL=admin@hlz.demo
# Obligatoire en production (aucune valeur par défaut). Hors production, un mot de passe aléatoire est généré et affiché une fois.
ADMIN_PASSWORD=<mot-de-passe-fort>
# Chemin de la base SQLite (défaut: data/delaipay.db)
DB_PATH=
