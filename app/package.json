{
  "name": "delaipay",
  "version": "1.0.0",
  "description": "DelaiPay — SaaS de suivi des délais de paiement (loi 69-21) pour cabinets d'expertise comptable",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "migrate": "node src/migrate.js",
    "repair-delais": "node src/repair.js",
    "seed": "node src/seed.js",
    "dev": "node --watch src/server.js",
    "demo:tenant": "node src/tenant-demo.js",
    "workspace:create": "node src/workspace-cli.js",
    "demo:reset": "node src/demo-reset.js",
    "platform:admin:create": "DP_PLATFORM_CLI_MODE=create node src/platform/cli.js",
    "platform:admin": "node src/platform/cli.js",
    "platform:purge": "node src/retention-cli.js",
    "backup": "node src/ops/backup.js",
    "restore": "node src/ops/restore.js",
    "verify:baseline": "node src/ops/verify-baseline.js",
    "staging:seed": "node src/ops/staging-seed.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "docx": "^8.5.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdfkit": "^0.15.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-js": "^1.6.11"
  }
}
