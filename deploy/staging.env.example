# =====================================================================================================
# DelaiPay STAGING — modèle de fichier d'environnement (AUCUN secret ici).
# Copier vers /etc/delaipay-staging/staging.env, propriétaire root:delaipay-staging, droits 0640.
# Générer les secrets sur le serveur (jamais les réutiliser d'une autre installation) :
#   JWT_SECRET            : openssl rand -hex 48
#   PLATFORM_SECRET_KEY   : openssl rand -hex 32
# Conserver une copie de ce fichier (avec ses secrets) dans le gestionnaire de mots de passe du fondateur.
# =====================================================================================================

# ---- Exécution
NODE_ENV=production
# Environnement déclaré : autorise `npm run staging:seed` (données fictives) et rien d'autre.
DELAIPAY_ENV=staging
# Port LOCAL uniquement (nginx en frontal) — jamais ouvert dans le pare-feu. Doit différer de la production.
PORT=4200
HOST=127.0.0.1
# Aucun compte ni client créé automatiquement au premier démarrage (seed fictif explicite, admin plateforme par la CLI).
DELAIPAY_AUTO_SEED=0

# ---- Réseau et domaines
# nginx sur la même machine : seul le proxy local est cru pour X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=loopback
# Espaces : <slug>.staging.delaipay.com ; console : admin.staging.delaipay.com (dérivée automatiquement).
TENANT_BASE_DOMAINS=staging.delaipay.com
# (facultatif) forcer l'hôte de la console : PLATFORM_HOSTS=admin.staging.delaipay.com
# (facultatif) restreindre la console à des IP : PLATFORM_ALLOWED_IPS=203.0.113.7,198.51.100.0/24
# Cookies Secure (HTTPS obligatoire) — noms « __Host- » pour la console.
COOKIE_SECURE=1

# ---- Données (HORS des versions déployées : survivent aux mises à jour et aux retours arrière)
DB_PATH=/var/lib/delaipay-staging/data/delaipay.db
UPLOADS_DIR=/var/lib/delaipay-staging/uploads

# ---- Secrets (À GÉNÉRER sur le serveur — laisser vides ici)
JWT_SECRET=
PLATFORM_SECRET_KEY=

# ---- Fuseau d'affichage de la console (IANA ; les espaces ont leur propre réglage)
PLATFORM_TIMEZONE=Africa/Casablanca

# ---- Géolocalisation (facultatif) : fichier CSV local « début,fin,pays » (ex. DB-IP Lite), jamais d'appel externe
# GEOIP_DB=/var/lib/delaipay-staging/geoip/dbip-country-lite.csv

# ---- Sauvegardes (npm run backup, déclenché par delaipay-staging-backup.timer)
BACKUP_DIR=/var/backups/delaipay-staging
BACKUP_STATUS_FILE=/var/lib/delaipay-staging/backup-status.json
BACKUP_PREFIX=delaipay-staging
# Chiffrement OBLIGATOIRE vers une clé PUBLIQUE (la clé privée reste hors ligne, chez le fondateur) :
#   age (recommandé) : BACKUP_AGE_RECIPIENT=age1…   (ou chemin d'un fichier de destinataires)
#   gpg             : BACKUP_GPG_RECIPIENT=backup@delaipay.com   (clé publique importée dans le trousseau de delaipay-staging)
BACKUP_AGE_RECIPIENT=
# Rotation : 7 quotidiennes, 4 hebdomadaires, 12 mensuelles
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
# Copie hors site, exécutée après chaque sauvegarde ({file} = archive chiffrée, {dir} = BACKUP_DIR). Exemples :
#   rclone : BACKUP_OFFSITE_CMD=rclone copy {file} offsite:delaipay-staging-backups/
#   rsync  : BACKUP_OFFSITE_CMD=rsync -a {file} {file}.sha256 backup@nas.example.org:/delaipay-staging/
BACKUP_OFFSITE_CMD=
