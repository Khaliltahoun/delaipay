# /etc/systemd/system/delaipay-staging-backup.service — sauvegarde chiffrée quotidienne (déclenchée par le .timer).
# Même isolement que le service principal ; réseau sortant autorisé UNIQUEMENT pour la copie hors site.
[Unit]
Description=DelaiPay staging — sauvegarde chiffrée
After=delaipay-staging.service

[Service]
Type=oneshot
User=delaipay-staging
Group=delaipay-staging
WorkingDirectory=/srv/delaipay-staging/current/app
EnvironmentFile=/etc/delaipay-staging/staging.env
# Node.js PROPRE à DelaiPay (/opt/node-24, root:root, lecture seule) : le Node du système et des autres applications n'est pas touché.
Environment=PATH=/opt/node-24/bin:/usr/bin:/bin
ExecStart=/opt/node-24/bin/node src/ops/backup.js
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=512M

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/srv/delaipay-staging/shared /srv/delaipay-staging/backups -/srv/delaipay-staging/.gnupg -/srv/delaipay-staging/.config/rclone
ReadOnlyPaths=/srv/delaipay-staging
InaccessiblePaths=-/srv/delaipay-staging/.ssh -/srv/delaipay-staging/repo.git
ProtectProc=invisible
ProcSubset=pid
PrivateUsers=yes
RemoveIPC=yes
KeyringMode=private
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap @module @clock
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal
SyslogIdentifier=delaipay-staging-backup
