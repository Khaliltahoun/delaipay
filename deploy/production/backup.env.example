# /etc/delaipay/backup.env (root:root 0600) — identifiants de la copie HORS SITE, lus par delaipay-backup.service SEUL
# (l'application ne les voit jamais). Clé d'application Backblaze B2 limitée à UN compartiment, en écriture seule.
RCLONE_CONFIG_B2OFFSITE_TYPE=b2
RCLONE_CONFIG_B2OFFSITE_ACCOUNT=
RCLONE_CONFIG_B2OFFSITE_KEY=
# rclone sans fichier de configuration ni cache dans le répertoire personnel (lecture seule sous systemd)
RCLONE_CONFIG=/dev/null
RCLONE_CACHE_DIR=/tmp/rclone-cache
