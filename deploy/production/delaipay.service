# /etc/systemd/system/delaipay.service — DelaiPay PRODUCTION, isolé (même modèle que le staging, docs/VPS_ISOLATION.md §2).
# Vérifier :  systemd-analyze verify delaipay.service   et   systemd-analyze security delaipay.service
[Unit]
Description=DelaiPay production (admin / *.delaipay.com)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=delaipay
Group=delaipay
WorkingDirectory=/srv/delaipay/current/app
# Secrets : root:root 0600, lu par systemd (PID 1) AVANT de passer à l'utilisateur — ni le déployeur ni aucun autre compte ne le lit.
EnvironmentFile=/etc/delaipay/production.env
# Node.js PROPRE à DelaiPay (/opt/node-24, root:root, lecture seule) : le Node du système et des autres applications n'est pas touché.
Environment=PATH=/opt/node-24/bin:/usr/bin:/bin
ExecStart=/opt/node-24/bin/node src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077

# ---- Ressources
MemoryMax=1536M
MemoryHigh=1280M
CPUQuota=200%
TasksMax=200
LimitNOFILE=8192

# ---- Système de fichiers : tout en lecture seule sauf les données de CE service
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ReadWritePaths=/srv/delaipay/shared
# Les versions et le reste de /srv/delaipay : lecture seule pour le service lui-même
ReadOnlyPaths=/srv/delaipay
InaccessiblePaths=-/srv/delaipay/.ssh -/srv/delaipay/repo.git -/srv/delaipay/pre-deploy -/srv/delaipay/backups
ProtectProc=invisible
ProcSubset=pid

# ---- Noyau, privilèges, espaces de noms
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
PrivateUsers=yes
# V8 (JIT) a besoin de pages écrivables ET exécutables : MemoryDenyWriteExecute est impossible pour Node.js.
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap @module @clock
SystemCallErrorNumber=EPERM

# ---- Réseau : n'écoute que sur 127.0.0.1 (HOST dans production.env) ; aucun trafic hors de la machine (pas d'appel externe)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

# ---- Journaux : journald (journalctl -u delaipay) — aucune donnée d'espace, ni corps de requête, ni secret
StandardOutput=journal
StandardError=journal
SyslogIdentifier=delaipay

[Install]
WantedBy=multi-user.target
