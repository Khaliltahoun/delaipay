# =====================================================================================================
# DelaiPay PRODUCTION — modèle de fichier d'environnement (AUCUN secret ici). Données RÉELLES des clients.
# Copier vers /etc/delaipay/production.env, propriétaire root:root, droits 0600 (répertoire root:root 0700).
# Lu UNIQUEMENT par systemd (PID 1) au démarrage du service : ni delaipay (déploiement), ni khalil, ni les agents ne le lisent.
# Générer les secrets sur le serveur (jamais les réutiliser d'une autre installation) :
#   JWT_SECRET            : openssl rand -hex 48
#   PLATFORM_SECRET_KEY   : openssl rand -hex 32
# Conserver une copie de ce fichier (avec ses secrets) dans le gestionnaire de mots de passe du fondateur.
# =====================================================================================================

# ---- Exécution
NODE_ENV=production
# Environnement déclaré : production — le seed fictif du staging y est REFUSÉ.
DELAIPAY_ENV=production
# Port LOCAL uniquement (nginx en frontal) — jamais ouvert dans le pare-feu. Doit différer de la production.
PORT=4300
HOST=127.0.0.1
# Aucun compte ni client créé automatiquement au premier démarrage (seed fictif explicite, admin plateforme par la CLI).
DELAIPAY_AUTO_SEED=0

# ---- Réseau et domaines
# nginx sur la même machine : seul le proxy local est cru pour X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=loopback
# Espaces : <slug>.delaipay.com ; console : admin.delaipay.com (dérivée automatiquement).
TENANT_BASE_DOMAINS=delaipay.com
# (facultatif) forcer l'hôte de la console : PLATFORM_HOSTS=admin.delaipay.com
# (facultatif) restreindre la console à des IP : PLATFORM_ALLOWED_IPS=203.0.113.7,198.51.100.0/24
# Cookies Secure (HTTPS obligatoire) — noms « __Host- » pour la console.
COOKIE_SECURE=1

# ---- Données (HORS des versions déployées : survivent aux mises à jour et aux retours arrière)
DB_PATH=/srv/delaipay/shared/data/delaipay.db
UPLOADS_DIR=/srv/delaipay/shared/uploads

# ---- Secrets (À GÉNÉRER sur le serveur — laisser vides ici)
JWT_SECRET=
PLATFORM_SECRET_KEY=

# ---- Fuseau d'affichage de la console (IANA ; les espaces ont leur propre réglage)
PLATFORM_TIMEZONE=Africa/Casablanca

# ---- Géolocalisation (facultatif) : fichier CSV local « début,fin,pays » (ex. DB-IP Lite), jamais d'appel externe
# GEOIP_DB=/srv/delaipay/shared/geoip/dbip-country-lite.csv

# ---- Sauvegardes (déclenchées par delaipay-backup.timer, 03:15)
BACKUP_DIR=/srv/delaipay/backups
BACKUP_STATUS_FILE=/srv/delaipay/shared/data/backup-status.json
BACKUP_PREFIX=delaipay
# Chiffrement OBLIGATOIRE vers une clé PUBLIQUE (la clé privée reste hors ligne, chez le fondateur) :
#   age (recommandé) : BACKUP_AGE_RECIPIENT=age1…   (ou chemin d'un fichier de destinataires)
#   gpg             : BACKUP_GPG_RECIPIENT=/srv/delaipay/backup-pubkey.asc   (fichier de clé PUBLIQUE, sans trousseau)
#                     ou BACKUP_GPG_RECIPIENT=backup@delaipay.com (clé publique importée dans /srv/delaipay/.gnupg)
BACKUP_AGE_RECIPIENT=
# Rotation : 7 quotidiennes, 4 hebdomadaires, 12 mensuelles
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
# Copie hors site : Backblaze B2 via rclone (identifiants dans /etc/delaipay/backup.env, lus par le service de sauvegarde SEUL).
# Remplacer BUCKET par le nom du compartiment B2 (privé, verrouillage d'objets activé).
BACKUP_OFFSITE_CMD=rclone copy --no-check-dest {file} b2offsite:BUCKET/ && rclone copy --no-check-dest {file}.sha256 b2offsite:BUCKET/
