## /etc/audit/rules.d/50-delaipay.rules — qui touche aux fichiers de DelaiPay PRODUCTION ?
## Lire : sudo ausearch -k delaipay_prod_access -i --start today      (voir docs/VPS_ISOLATION.md §A9)

## 1. Tout accès (lecture, écriture, attributs) par un AUTRE compte que delaipay — root compris.
-a always,exit -F arch=b64 -F dir=/srv/delaipay -F perm=rwa -F uid!=delaipay -k delaipay_prod_access
-a always,exit -F arch=b32 -F dir=/srv/delaipay -F perm=rwa -F uid!=delaipay -k delaipay_prod_access

## 2. Accès SOUS l'identité delaipay mais depuis la session d'un autre compte (sudo -u / su / runuser) :
##    l'identifiant de connexion (auid) trahit le compte d'origine. Le service (lancé par systemd) a auid=unset : non journalisé.
-a always,exit -F arch=b64 -F dir=/srv/delaipay -F perm=rwa -F uid=delaipay -F auid!=delaipay -F auid!=unset -k delaipay_prod_impersonation
-a always,exit -F arch=b32 -F dir=/srv/delaipay -F perm=rwa -F uid=delaipay -F auid!=delaipay -F auid!=unset -k delaipay_prod_impersonation

## 3. Secrets : TOUT accès, quel que soit le compte (attendu : systemd à chaque démarrage du service, vos propres modifications).
-a always,exit -F arch=b64 -F dir=/etc/delaipay -F perm=rwa -k delaipay_prod_secrets
-a always,exit -F arch=b32 -F dir=/etc/delaipay -F perm=rwa -k delaipay_prod_secrets

## 4. Fichiers qui, modifiés, ouvriraient l'accès : unités, sudoers, sshd, lanceur d'administration, Node.js de DelaiPay.
-w /etc/systemd/system/delaipay.service -p wa -k delaipay_prod_config
-w /etc/systemd/system/delaipay-backup.service -p wa -k delaipay_prod_config
-w /etc/systemd/system/delaipay-backup.timer -p wa -k delaipay_prod_config
-w /etc/sudoers.d/delaipay -p wa -k delaipay_prod_config
-w /etc/ssh/sshd_config.d/50-delaipay.conf -p wa -k delaipay_prod_config
-w /usr/local/sbin/delaipay-run -p wa -k delaipay_prod_config

## (Facultatif, après une semaine sans surprise) rendre les règles immuables jusqu'au prochain redémarrage :
## -e 2
