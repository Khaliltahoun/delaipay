# /etc/logrotate.d/delaipay-staging — journal des déploiements (l'application et les sauvegardes écrivent dans journald :
#   journalctl -u delaipay-staging   /   journalctl -u delaipay-staging-backup).
/srv/delaipay-staging/deploy.log {
    weekly
    rotate 12
    maxsize 20M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su delaipay-staging delaipay-staging
}
